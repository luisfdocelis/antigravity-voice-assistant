{
  "name": "antigravity-voice-assistant",
  "displayName": "Antigravity Voice Assistant",
  "description": "Asistente de voz accesible para el chat y prompt de Antigravity IDE (Dictado de prompts por voz y lectura con síntesis neuronal)",
  "version": "3.1.0",
  "publisher": "luisfdocelis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisfdocelis/antigravity-voice-assistant"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Google",
    "Voice",
    "Accessibility",
    "Other"
  ],
  "keywords": [
    "voice",
    "prompt",
    "antigravity",
    "dictation",
    "tts",
    "stt",
    "accessibility"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx -y @vscode/vsce package",
    "verify": "bash .agents/scripts/verify.sh"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antigravity-voice.dictatePrompt",
        "title": "Antigravity Voice: Dictar Prompt por Voz",
        "icon": "$(mic)"
      },
      {
        "command": "antigravity-voice.readResponse",
        "title": "Antigravity Voice: Leer Respuesta o Selección",
        "icon": "$(unmute)"
      },
      {
        "command": "antigravity-voice.stopAudio",
        "title": "Antigravity Voice: Detener Audio",
        "icon": "$(mute)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity-voice.dictatePrompt",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "antigravity-voice.readResponse",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "antigravity-voice.stopAudio",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "Antigravity Voice",
      "properties": {
        "antigravityVoice.voice": {
          "type": "string",
          "default": "es-ES-AlvaroNeural",
          "description": "Voz neural para síntesis de lectura",
          "enum": [
            "es-ES-AlvaroNeural",
            "es-ES-ElviraNeural",
            "es-MX-JorgeNeural",
            "es-MX-DaliaNeural",
            "es-CO-SalomeNeural",
            "es-US-PalomaNeural"
          ]
        },
        "antigravityVoice.dictateDuration": {
          "type": "number",
          "default": 5,
          "description": "Duración en segundos de la captura de voz para el dictado"
        },
        "antigravityVoice.language": {
          "type": "string",
          "default": "es-ES",
          "description": "Código de idioma para reconocimiento de voz (es-ES, es-MX, en-US)"
        },
        "antigravityVoice.rate": {
          "type": "number",
          "default": 1.0,
          "description": "Velocidad de reproducción de la voz (0.8 a 1.5)"
        }
      }
    }
  }
}
